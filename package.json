{
  "name": "worth",
  "version": "0.1.0",
  "private": true,
  "description": "Local net worth tracker, forked from Codex Desktop",
  "author": "MangoWork",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "package": "npm run build && node scripts/package.mjs",
    "package:mac": "npm run build && node scripts/package.mjs --platform=mac",
    "package:win": "npm run build && node scripts/package.mjs --platform=win",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "start": "electron .",
    "test:worth": "node --test tests/worth.test.mjs",
    "test:ui": "npm run build && node scripts/qa.mjs",
    "package:local": "npm run build && electron-builder --config electron-builder.config.cjs --mac dir --arm64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.45.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
